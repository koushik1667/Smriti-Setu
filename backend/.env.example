PORT=5000
NODE_ENV=development

# Supabase Credentials (Render & Local)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# JWT & AI Keys
JWT_SECRET=your_jwt_secret_here

# Gemini API Key (Supports single key OR comma-separated keys for auto-failover: key1,key2,key3)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Gemini Model Override (Default auto-prioritizes: gemini-3.6-flash -> gemini-3.6 -> gemini-2.5-flash -> gemini-2.0-flash)
GEMINI_MODEL=gemini-3.6-flash


# MongoDB Fallback (Optional)
MONGODB_URI=mongodb://localhost:27017/smriti_setu

# Render Keep-Alive / Anti-Sleep Configuration
# Set KEEP_ALIVE=true to force keep-alive in any environment (auto-enabled in production/Render)
KEEP_ALIVE=true
# Ping interval in minutes (Render free tier sleeps after 15 minutes of inactivity; 10m is optimal)
KEEP_ALIVE_INTERVAL_MINUTES=10
# Optional custom ping URL (defaults to RENDER_EXTERNAL_URL or https://pharmavision-backend.onrender.com/api/health)
KEEP_ALIVE_URL=https://pharmavision-backend.onrender.com/api/health
