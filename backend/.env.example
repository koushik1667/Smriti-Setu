PORT=5000
NODE_ENV=development

# Supabase Credentials (Render & Local)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# JWT & AI Keys
JWT_SECRET=your_jwt_secret_here

# Gemini API Key (Supports single key OR comma-separated keys for auto-failover: key1,key2,key3)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Gemini Model Override (Default auto-prioritizes: gemini-3.7-flash -> gemini-3.6-flash -> gemini-3.5-flash -> gemini-2.5-flash)
GEMINI_MODEL=gemini-3.7-flash

# MongoDB Fallback (Optional)
MONGODB_URI=mongodb://localhost:27017/smriti_setu
